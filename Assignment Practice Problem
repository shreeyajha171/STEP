class Node {
    String data;
    Node next;

    Node(String data) {
        this.data = data;
        this.next = null;
    }
}

class Stack {
    Node top;
    int size;

    Stack() {
        top = null;
        size = 0;
    }

    void push(String plate) {
        Node newNode = new Node(plate);
        newNode.next = top;
        top = newNode;
        size++;

        System.out.println("push " + plate + " -> top " + top.data + ", size " + size);
    }

    String pop() {
        if (isEmpty()) {
            System.out.println("pop -> stack is empty");
            return null;
        }

        String plate = top.data;
        top = top.next;
        size--;

        System.out.println("pop -> " + plate + ", size " + size);
        return plate;
    }

    String peek() {
        if (isEmpty()) {
            System.out.println("peek -> stack is empty");
            return null;
        }

        System.out.println("peek -> " + top.data);
        return top.data;
    }

    boolean isEmpty() {
        boolean empty = (top == null);
        System.out.println("isEmpty -> " + empty);
        return empty;
    }
}

public class Main {
    public static void main(String[] args) {
        Stack stack = new Stack();

        stack.push("P1");
        stack.push("P2");
        stack.peek();
        stack.pop();
        stack.push("P3");
        stack.pop();
        stack.pop();
        stack.pop();
        stack.isEmpty();
    }
}
