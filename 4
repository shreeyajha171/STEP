import java.util.*;

abstract class Cab {
    double km;

    Cab(double km) {
        this.km = km;
    }

    abstract double rate();

    boolean hasNightService() {
        return false;
    }

    double fare(boolean night) {
        double fare = Math.max(100, km * rate());

        if (night && hasNightService()) {
            fare *= 1.2;
        }

        return fare;
    }
}

class Mini extends Cab {
    Mini(double km) {
        super(km);
    }

    double rate() {
        return 10;
    }
}

class Sedan extends Cab {
    Sedan(double km) {
        super(km);
    }

    double rate() {
        return 14;
    }

    boolean hasNightService() {
        return true;
    }
}

class SUV extends Cab {
    SUV(double km) {
        super(km);
    }

    double rate() {
        return 18;
    }

    boolean hasNightService() {
        return true;
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        double total = 0;

        for (int i = 0; i < n; i++) {
            String type = sc.next();
            double km = sc.nextDouble();
            String time = sc.next();

            boolean night = time.equals("NIGHT");
            Cab cab;

            switch (type) {
                case "MINI":
                    cab = new Mini(km);
                    break;
                case "SEDAN":
                    cab = new Sedan(km);
                    break;
                default:
                    cab = new SUV(km);
            }

            if (night && !cab.hasNightService()) {
                System.out.println(type + ": night service not available");
            } else {
                double fare = cab.fare(night);
                total += fare;
                System.out.printf("%s: %.2f%n", type, fare);
            }
        }

        System.out.printf("Total: %.2f%n", total);
    }
}
