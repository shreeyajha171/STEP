import java.util.*;
import java.util.regex.*;

abstract class Question {
    protected String text;
    protected String correctAnswer;
    protected String studentAnswer;
    protected double points;

    Question(String text, String correctAnswer,
             String studentAnswer, double points) {
        this.text = text;
        this.correctAnswer = correctAnswer;
        this.studentAnswer = studentAnswer;
        this.points = points;
    }

    abstract double grade();
}

class MCQ extends Question {
    MCQ(String text, String correct, String student, double points) {
        super(text, correct, student, points);
    }

    @Override
    double grade() {
        return studentAnswer.equals(correctAnswer) ? points : 0;
    }
}

class TF extends Question {
    TF(String text, String correct, String student, double points) {
        super(text, correct, student, points);
    }

    @Override
    double grade() {
        return studentAnswer.equals(correctAnswer) ? points : 0;
    }
}

class Essay extends Question {
    Essay(String text, String correct, String student, double points) {
        super(text, correct, student, points);
    }

    @Override
    double grade() {
        String[] keywords = correctAnswer.split(",");
        String answer = studentAnswer.toLowerCase(Locale.ROOT);
        int matched = 0;

        for (String keyword : keywords) {
            String word = keyword.trim().toLowerCase(Locale.ROOT);

            if (!word.isEmpty() && answer.contains(word)) {
                matched++;
            }
        }

        if (matched >= 2) {
            return points * 0.75;
        } else if (matched == 1) {
            return points * 0.50;
        }

        return 0;
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = Integer.parseInt(sc.nextLine().trim());
        double total = 0;

        Pattern pattern = Pattern.compile("\"([^\"]*)\"|(\\S+)");

        for (int i = 0; i < n; i++) {
            String line = sc.nextLine();
            Matcher matcher = pattern.matcher(line);
            List<String> tokens = new ArrayList<>();

            while (matcher.find()) {
                tokens.add(
                    matcher.group(1) != null
                        ? matcher.group(1)
                        : matcher.group(2)
                );
            }

            String type = tokens.get(0);
            String text = tokens.get(1);
            String correct = tokens.get(2);
            String student = tokens.get(3);
            double points = Double.parseDouble(tokens.get(4));

            Question question;

            switch (type) {
                case "MCQ":
                    question = new MCQ(text, correct, student, points);
                    break;

                case "TF":
                    question = new TF(text, correct, student, points);
                    break;

                case "ESSAY":
                    question = new Essay(text, correct, student, points);
                    break;

                default:
                    throw new IllegalArgumentException(
                        "Invalid question type"
                    );
            }

            double score = question.grade();
            System.out.printf("%s: %.2f%n", type, score);
            total += score;
        }

        System.out.printf("Total Score: %.2f%n", total);
        sc.close();
    }
}
