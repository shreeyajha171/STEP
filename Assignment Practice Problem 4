class Node {
    String data;
    Node next;

    Node(String data) {
        this.data = data;
        this.next = null;
    }
}

public class Main {

    static Node removeFirst(Node head, String booking) {

        if (head == null) {
            System.out.println(booking + " not found");
            return head;
        }

        // If booking is at the head
        if (head.data.equals(booking)) {
            return head.next;
        }

        // Search for the booking
        Node current = head;

        while (current.next != null &&
               !current.next.data.equals(booking)) {
            current = current.next;
        }

        // Booking not found
        if (current.next == null) {
            System.out.println(booking + " not found");
            return head;
        }

        // Remove the first occurrence
        current.next = current.next.next;

        return head;
    }

    static void display(Node head) {
        Node current = head;

        while (current != null) {
            System.out.print(current.data + " -> ");
            current = current.next;
        }

        System.out.println("null");
    }

    public static void main(String[] args) {

        Node head = new Node("104");
        head.next = new Node("101");
        head.next.next = new Node("107");
        head.next.next.next = new Node("101");

        String booking = "101";

        head = removeFirst(head, booking);

        display(head);
    }
}
